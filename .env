# =============================================================================
# GraphRAG — environment template.  Copy to `.env` and edit.
#   cp .env.example .env
# Every value below has a working default except the LLM/embedding API keys.
# =============================================================================

# ---------- Application ----------
APP_NAME=GraphRAG
ENV=development                     # development | production
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# ---------- Security / JWT ----------
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@graphrag.ai
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!

# ---------- Document metadata store ----------
# memory  -> in-process dict, zero infrastructure (dev / tests / single process)
# mongo   -> MongoDB via motor (production, see docker-compose.yml)
DOC_STORE=memory
MONGO_URI=mongodb://localhost:27017
MONGO_DB=graphrag

# ---------- Knowledge graph ----------
# kuzu    -> embedded graph database that speaks Cypher (zero infra, local file)
# neo4j   -> Neo4j server via bolt (production, see docker-compose.yml)
GRAPH_BACKEND=kuzu
KUZU_PATH=./data/kuzu
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphragpass
NEO4J_DATABASE=neo4j

# ---------- Vector store ----------
# numpy   -> dependency-free persistent store (dev / tests)
# chroma  -> ChromaDB persistent client (production)
VECTOR_STORE=numpy
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=graphrag_chunks

# ---------- Embeddings ----------
# hash                 -> deterministic offline lexical hashing (no model download)
# openai               -> OpenAI embeddings endpoint
# sentence-transformers-> BAAI/bge-large-en-v1.5 (requires requirements-ml.txt)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- LLM ----------
# mock    -> deterministic offline responder (no API key; powers tests & demo)
# openai  -> any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, Ollama)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=90

# ---------- Ingestion & retrieval ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
INGEST_CONCURRENCY=4
USE_LLM_EXTRACTION=true
RETRIEVAL_TOP_K=8
GRAPH_HOPS=2
VECTOR_WEIGHT=0.6
GRAPH_WEIGHT=0.4
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000/api
